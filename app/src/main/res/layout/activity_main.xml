<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵 Music Stopper"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="يراقب الصوت ويكتم أي موسيقى تلقائيًا"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="▶ بدء المراقبة"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="خيارات الإيقاف"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وضع لا تقاطع"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="كتم صوت الوسائط"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMediaKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إرسال أمر إيقاف للتطبيق"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchNoise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تشغيل صوت تنبيه"
            android:checked="false"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الحالة: متوقف"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="#EEEEEE" />

    </LinearLayout>
</ScrollView>
